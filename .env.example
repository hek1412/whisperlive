# WhisperLive Unified Server Configuration

# =============================================================================
# API Authentication
# =============================================================================
API_KEY=your-secret-api-key-change-in-production

# =============================================================================
# LLM Configuration for Summarization (Optional)
# =============================================================================

# Option 1: Local Ollama
# Install Ollama: https://ollama.com/
# Run: ollama pull qwen2.5:latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
# OLLAMA_API_KEY is not required for local Ollama

# Option 2: External vLLM API
# OLLAMA_BASE_URL=https://ollama-ui-llm-service.agents.1t.ru/api
# OLLAMA_API_KEY=sk-your-api-key-here
# OLLAMA_MODEL=vllm.Qwen3-VL-32B-Instruct-AWQ

# =============================================================================
# Session Management
# =============================================================================
SESSION_TTL=3600           # Session time-to-live in seconds (default: 3600 = 1 hour)
CLEANUP_INTERVAL=60        # Cleanup task interval in seconds (default: 60)

# =============================================================================
# CPU Optimization
# =============================================================================
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# =============================================================================
# Proxy Settings (if needed)
# =============================================================================
# https_proxy=http://proxy.example.com:8080
# http_proxy=http://proxy.example.com:8080
# no_proxy=localhost,127.0.0.1

# =============================================================================
# Server Configuration
# =============================================================================
# These can also be set via command-line arguments
# SERVER_HOST=0.0.0.0
# SERVER_PORT=9090
# BACKEND=faster_whisper
# CACHE_PATH=~/.cache/whisper-live/

# =============================================================================
# TensorRT Backend Configuration (GPU)
# =============================================================================
# Use when BACKEND=tensorrt
# TRT_MODEL_PATH=./trt_engines/whisper_large_v3_float16
# TRT_MULTILINGUAL=true
# TRT_PY_SESSION=false

# GPU Configuration
# CUDA_VISIBLE_DEVICES=0
# NVIDIA_VISIBLE_DEVICES=all
