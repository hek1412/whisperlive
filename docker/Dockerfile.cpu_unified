# Stage 1: Dependencies layer (cached unless requirements change)
FROM python:3.10-slim-bookworm AS dependencies

ARG DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt update && apt install -y \
    portaudio19-dev \
    ffmpeg \
    git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Update pip
RUN pip install --no-cache-dir -U "pip>=24"

# Create working directory
WORKDIR /app

# Copy ONLY requirements files (this layer is cached unless requirements change)
COPY requirements/server.txt /app/requirements_server.txt
# Станет:
# COPY requirements/server_minimal.txt /app/requirements_server.txt
COPY requirements_api.txt /app/

# Install Python dependencies (heavy operation, cached)
RUN pip install --no-cache-dir -r requirements_server.txt && \
    pip install --no-cache-dir -r requirements_api.txt

# Stage 2: Application layer (rebuilt on code changes)
FROM dependencies AS application

# Copy application code (this layer rebuilds on every code change)
COPY whisper_live /app/whisper_live
COPY run_server_unified.py /app/
COPY prompt.yaml /app/

# Set environment variables for CPU optimization
ENV OMP_NUM_THREADS=4
ENV MKL_NUM_THREADS=4

# Expose port
EXPOSE 9090

# Run server
CMD ["python", "run_server_unified.py"]
