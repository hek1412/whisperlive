# Stage 1: Base image with NVIDIA TensorRT-LLM
FROM nvidia/cuda:12.1.0-devel-ubuntu22.04 AS tensorrt-base

ARG DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3-dev \
    git \
    wget \
    portaudio19-dev \
    ffmpeg \
    build-essential \
    libopenmpi-dev \
    openmpi-bin \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.10 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch with CUDA support
RUN pip install --no-cache-dir \
    torch==2.1.0 \
    torchaudio==2.1.0 \
    --index-url https://download.pytorch.org/whl/cu121

# Install TensorRT-LLM (version 0.18.2 as per documentation)
RUN pip install --no-cache-dir tensorrt_llm==0.18.2 -U --extra-index-url https://pypi.nvidia.com

# Fix onnx compatibility issue
RUN pip install --no-cache-dir --upgrade onnx==1.15.0

WORKDIR /app

# Clone TensorRT-LLM examples repository
RUN git clone https://github.com/NVIDIA/TensorRT-LLM.git /app/TensorRT-LLM-examples && \
    cd /app/TensorRT-LLM-examples && \
    git checkout v0.18.2

# Stage 2: Application with dependencies
FROM tensorrt-base AS application

WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements/server.txt /app/requirements_server.txt
COPY requirements_api.txt /app/

RUN pip install --no-cache-dir -r requirements_server.txt && \
    pip install --no-cache-dir -r requirements_api.txt

# Copy TensorRT engine build script
COPY scripts/build_whisper_tensorrt.sh /app/

# Copy application code
COPY whisper_live /app/whisper_live
COPY run_server_unified.py /app/
COPY prompt.yaml /app/

# Set environment variables
ENV CUDA_VISIBLE_DEVICES=0
ENV OMP_NUM_THREADS=8
ENV MKL_NUM_THREADS=8

# Expose port
EXPOSE 9090

# Entry point
CMD ["python", "run_server_unified.py", "--backend", "tensorrt"]
